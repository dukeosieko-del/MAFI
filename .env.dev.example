# Set this to https://dev.janjez.social for Cloudflare tunnel testing.
NEXT_PUBLIC_SITE_URL=https://dev.janjez.social

# Use your Supabase project values; never commit production service-role keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=

# Use sandbox/test credentials for local checkout and payment testing.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=

# Keep external order fulfilment disabled during local development.
SMM_FULFILLMENT_ENABLED=false
SMM_API_URL=https://dripfeedpanel.com/api/v2
SMM_API_KEY=

# Paste the token for the dev-janjez-social Cloudflare Tunnel.
TUNNEL_TOKEN=
