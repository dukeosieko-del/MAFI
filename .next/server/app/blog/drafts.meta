{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/blog/layout,_N_T_/blog/drafts/layout,_N_T_/blog/drafts/page,_N_T_/blog/drafts"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/blog/drafts/__PAGE__",
    "/blog/drafts",
    "/blog",
    "/_index",
    "/_head"
  ]
}