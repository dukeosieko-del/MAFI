{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/blog/layout,_N_T_/blog/write/layout,_N_T_/blog/write/page,_N_T_/blog/write"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/blog/write/__PAGE__",
    "/blog/write",
    "/blog",
    "/_index",
    "/_head"
  ]
}