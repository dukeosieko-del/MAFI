{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/blog/layout,_N_T_/blog/my-articles/layout,_N_T_/blog/my-articles/page,_N_T_/blog/my-articles"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/blog/my-articles/__PAGE__",
    "/blog/my-articles",
    "/blog",
    "/_index",
    "/_head"
  ]
}